DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
PLANNER_MODEL=deepseek-v4-flash
RERANK_MODEL=deepseek-v4-flash
ANSWER_MODEL=deepseek-v4-pro
ANSWER_TEMPERATURE=0
TAVILY_API_KEY=

VECTOR_DB_ROOT=milvus_db
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=true

ENTERPRISE_THRESHOLD=0.68
TENDER_THRESHOLD=0.65
PRODUCT_THRESHOLD=0.66
LAWS_THRESHOLD=0.62
POLICY_THRESHOLD=0.62

TOP_K_PER_CATEGORY=8
HYBRID_RECALL_MULTIPLIER=4
HYBRID_RRF_K=60
RERANK_CANDIDATE_LIMIT=30
FINAL_CANDIDATE_LIMIT=20
RERANK_WEB_THRESHOLD=0.55
RERANK_MODE=llm

MAX_CONTEXT_CHARS=28000
MAX_CONTEXT_ITEM_CHARS=4000
MAX_CONTEXT_PER_CATEGORY=5
MAX_CONTEXT_PER_SOURCE=2

# Web 服务（示例值，不包含真实密钥）
ENVIRONMENT=development
DATABASE_URL=mysql+asyncmy://bidding:change-me@127.0.0.1:3306/bidding_agent
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_QUESTION_CHARS=6000
MAX_UPLOAD_BYTES=20971520
MAX_ACTIVE_GENERATIONS_PER_USER=8
RATE_LIMIT_PER_MINUTE=30
WEBSOCKET_IDLE_SECONDS=90
RECONNECT_GRACE_SECONDS=120
CONTEXT_TURNS=0
CONTEXT_TTL_SECONDS=3600
STREAM_TTL_SECONDS=900
STREAM_MAX_EVENTS=4000

# Lite 必须保持 API_WORKERS=1；生产 Milvus Server 才可按压测调整
MILVUS_MODE=lite
PRIVATE_MILVUS_URI=milvus_db/private/main.db
API_WORKERS=1
MILVUS_THREAD_LIMIT=4
UPLOAD_ROOT=uploads
PRIVATE_COLLECTION=private_documents
